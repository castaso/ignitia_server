# Copy this file to .env and adjust values. All values are optional
# (sane defaults are compiled into app/config.py).

# --- Server ---
# Host/port used by `python run.py`
HOST=0.0.0.0
PORT=86

# --- Security ---
# Secret used to sign JWT tokens. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in hours
JWT_EXPIRE_HOURS=720

# --- Office geo-fence (server side, authoritative) ---
# Coordinates of the office centre and allowed radius in metres.
# The Flutter client's placeholder values live in lib/config/office_location_config.dart
# (23.810331, 90.412521, 300 m) - mirror or override them here.
OFFICE_LATITUDE=23.810331
OFFICE_LONGITUDE=90.412521
OFFICE_RADIUS_METERS=300

# --- Attendance policy ---
# Office in/out times (24h). Used for late_duration and overtimE_MINUTES.
OFFICE_START_TIME=09:00
OFFICE_END_TIME=18:00
# Cut-off: after this hour a check-in is recorded as a missing check-in day.
# Leave empty to disable.

# --- Face verification ---
# Similarity threshold 0..1. Lower = stricter (must look more like the
# reference photo). The demo uses a perceptual-hash similarity score.
FACE_SIMILARITY_THRESHOLD=0.72
# Directory where submitted face snapshots are stored.
UPLOAD_DIR=uploads/faces

# --- Database ---
DATABASE_URL=sqlite:///./ignitia.db
